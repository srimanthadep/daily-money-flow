{
  "name": "daily-money-flow-monorepo",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "install:all": "npm --prefix frontend install --legacy-peer-deps && npm --prefix backend install",
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "build": "npm --prefix frontend install --legacy-peer-deps && npm --prefix frontend run build",
    "build:dev": "npm --prefix frontend run build:dev",
    "start": "npm --prefix backend run start",
    "lint": "npm --prefix frontend run lint",
    "preview": "npm --prefix frontend run preview"
  }
}
